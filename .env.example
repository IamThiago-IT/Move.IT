# Postgres (Neon). DATABASE_URL usa o host pooled; DIRECT_URL usa o host direto para migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="gere-com-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth App
# Callback local: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Pomodoro (minutos). Use 1 em testes/E2E se necessario.
POMODORO_MINUTES="25"
CHALLENGE_EXPIRES_MINUTES="1440"

# Seed de demonstracao: nunca habilite em producao.
SEED_DEMO="false"
